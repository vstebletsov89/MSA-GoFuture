@startuml C2_GoFuture_Event_Platform
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title GoFuture — Event-Driven Platform To-Be (C2)

Person(passenger, "Пассажир", "Заказывает поездки")
Person(driver, "Водитель", "Выполняет поездки и отправляет геопозицию")

System_Boundary(gofuture, "GoFuture Platform") {

    Container(passenger_app, "Passenger Mobile App", "iOS / Android / Huawei", "Приложение пассажира")
    Container(driver_app, "Driver Mobile App", "iOS / Android / Huawei", "Приложение водителя")

    Container(api_gateway, "API Gateway", "NGINX / Envoy", "REST API, auth, rate limiting, routing")

    Container(booking_service, "Booking Service", "Microservice", "Создание и управление поездкой")
    Container(driver_service, "Driver Service", "Microservice", "Профили, доступность и геопозиция водителей")
    Container(pricing_service, "Pricing Service", "Microservice", "Динамическое ценообразование")
    Container(payment_service, "Payments Service", "Microservice", "Оплаты, возвраты, выплаты")
    Container(fraud_service, "Fraud Service", "Microservice", "Антифрод-проверки")
    Container(notification_service, "Notification Service", "Microservice", "Push-уведомления")
    Container(geography_service, "Geography Service", "Microservice", "Маршруты, зоны, геоданные")
    Container(analytics_service, "Analytics Service", "Microservice", "Аналитика и отчётность")

    ContainerQueue(kafka, "Kafka Cluster", "Kafka", "Доменные события, партиционирование по region_id")
    Container(kstreams_flink, "Stream Processing", "Kafka Streams / Flink", "Real-time обработка событий, агрегаты спроса/предложения, fraud signals")

    Container(outbox_relay, "Outbox Relay / Debezium", "Debezium CDC", "Читает outbox/WAL PostgreSQL и публикует события в Kafka")
    Container(schema_registry, "Schema Registry", "Avro / Protobuf", "Версионирование контрактов событий")

    ContainerDb(booking_db, "Booking DB", "PostgreSQL", "Поездки, статусы, outbox")
    ContainerDb(driver_db, "Driver DB", "PostgreSQL / Redis", "Водители, доступность, координаты, outbox")
    ContainerDb(pricing_db, "Pricing DB", "PostgreSQL / Redis", "Тарифы, коэффициенты, агрегаты")
    ContainerDb(payment_db, "Payments DB", "PostgreSQL", "Платежи, возвраты, выплаты, outbox")
    ContainerDb(fraud_db, "Fraud DB", "PostgreSQL", "Правила и результаты проверок")
    ContainerDb(analytics_db, "Analytics DB", "ClickHouse", "События, витрины, BI-отчёты")

    Container(observability, "Observability Platform", "Prometheus / Grafana / Loki / Alertmanager / OpenTelemetry", "Метрики, логи, трейсы, алерты")
}

System_Ext(payment_provider, "Local Payment Providers", "Яндекс Пэй и локальные платёжные провайдеры")
System_Ext(push_provider, "Push Providers", "FCM / APNS / Huawei Push Kit")
System_Ext(map_provider, "Map Providers", "Яндекс Карты и локальные карты")

Rel(passenger, passenger_app, "Использует")
Rel(driver, driver_app, "Использует")

Rel(passenger_app, api_gateway, "HTTPS/REST")
Rel(driver_app, api_gateway, "HTTPS/REST")

Rel(api_gateway, booking_service, "REST", "Создать поездку, отменить, получить статус")
Rel(api_gateway, driver_service, "REST", "Обновить статус и геопозицию")
Rel(api_gateway, payment_service, "REST", "Оплатить поездку")
Rel(api_gateway, pricing_service, "REST", "Получить цену")
Rel(api_gateway, geography_service, "REST", "Маршрут, зона, ETA")

Rel(booking_service, booking_db, "R/W")
Rel(driver_service, driver_db, "R/W")
Rel(pricing_service, pricing_db, "R/W")
Rel(payment_service, payment_db, "R/W")
Rel(fraud_service, fraud_db, "R/W")
Rel(analytics_service, analytics_db, "R/W")

Rel(booking_db, outbox_relay, "CDC", "Booking outbox")
Rel(driver_db, outbox_relay, "CDC", "Driver outbox")
Rel(payment_db, outbox_relay, "CDC", "Payment outbox")

Rel(outbox_relay, kafka, "Публикует", "Доменные события")
Rel(schema_registry, kafka, "Контракты событий", "Avro / Protobuf schemas")

Rel(booking_service, kafka, "Публикует", "BookingCreated, BookingCancelled, RideStarted, RideCompleted")
Rel(driver_service, kafka, "Публикует", "DriverLocationUpdated, DriverAvailable, DriverAssigned")
Rel(pricing_service, kafka, "Публикует", "PriceCalculated, SurgeMultiplierChanged")
Rel(payment_service, kafka, "Публикует", "PaymentAuthorized, PaymentCaptured, PaymentFailed")
Rel(fraud_service, kafka, "Публикует", "FraudCheckPassed, FraudCheckFailed")
Rel(geography_service, kafka, "Публикует", "RouteCalculated, ZoneDemandChanged")

Rel(kafka, kstreams_flink, "Потребляет", "DriverLocationUpdated, BookingCreated, RideCompleted")
Rel(kstreams_flink, pricing_service, "Обновляет агрегаты", "Demand/Supply, surge")
Rel(kstreams_flink, fraud_service, "Передаёт признаки", "Fraud signals")
Rel(kstreams_flink, analytics_service, "Передаёт события", "Real-time analytics")

Rel(kafka, booking_service, "Потребляет", "DriverAssigned, PriceCalculated, PaymentCaptured, FraudCheckPassed/Failed")
Rel(kafka, driver_service, "Потребляет", "BookingCreated, BookingCancelled, RideCompleted")
Rel(kafka, payment_service, "Потребляет", "RideCompleted")
Rel(kafka, notification_service, "Потребляет", "BookingCreated, DriverAssigned, PaymentCaptured, PaymentFailed")
Rel(kafka, analytics_service, "Потребляет", "Все доменные события")

Rel(payment_service, payment_provider, "HTTPS/API", "Оплата, возврат, выплата")
Rel(notification_service, push_provider, "HTTPS/API", "Push-уведомления")
Rel(geography_service, map_provider, "HTTPS/API", "Маршруты и геокодинг")

Rel(booking_service, observability, "Метрики / логи / трейсы")
Rel(driver_service, observability, "Метрики / логи / трейсы")
Rel(pricing_service, observability, "Метрики / логи / трейсы")
Rel(payment_service, observability, "Метрики / логи / трейсы")
Rel(fraud_service, observability, "Метрики / логи / трейсы")
Rel(notification_service, observability, "Метрики / логи / трейсы")
Rel(kafka, observability, "Kafka metrics")
Rel(kstreams_flink, observability, "Stream processing metrics")
Rel(outbox_relay, observability, "CDC lag / errors")

@enduml